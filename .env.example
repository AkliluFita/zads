# Required for /admin. Use strong unique values in the server environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: SendGrid enables inquiry alert emails. Inquiries persist even without it.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ALERT_EMAIL=Sazeleke@zadsplc.et

# Optional server configuration
PORT=4174
HOST=127.0.0.1
ZADS_DATA_FILE=./data/zads.json
NODE_ENV=production
